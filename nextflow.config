// Paludamentum: evidence integration pipeline for the Gaius-Augustus gene finders.
//
// The launcher (paludamentum, python -m paludamentum) passes conf/base.config
// and the user config explicitly with -c. This file makes a bare
// `nextflow run main.nf` work as well.
manifest {
  name            = 'Gaius-Augustus/Paludamentum'
  description     = 'Evidence integration pipeline for deep learning gene finders'
  homePage        = 'https://github.com/Gaius-Augustus/Paludamentum'
  mainScript      = 'main.nf'
  version         = '0.3.0'
  nextflowVersion = '>=25.04.0'
}

includeConfig 'conf/base.config'
