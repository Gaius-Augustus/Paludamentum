// conf/base.config
//
// Core, cluster-agnostic configuration.
// No cluster names, no site-specific paths.
docker.enabled = false
params {
  threads = 48
  // The launcher sets <genefinder>_results.
  outdir = "results"
  genome = null
  proteins = null
  odb12Partitions = []
  rnaseq_sra_single = []
  rnaseq_sra_paired = []
  isoseq_sra        = []
  rnaseq_single     = []
  rnaseq_paired     = []
  isoseq            = []
  rnaseq_bam        = null   // list of aligned short-read BAM files
  // pyVARUS output directories (stringtie.gtf, hints.gff, manifest) instead
  // of BAMs: short-read runs, --longreads runs, and one `varus assemble
  // --short --long` directory (the assembly of the Drusilla flow in mixed mode)
  rnaseq_varus      = null
  isoseq_varus      = null
  mixed_varus       = null
  stringtie         = null   // StringTie assemblies (GTF) made outside the pipeline
  tiberius {
    run          = false
    result       = null
    model_cfg    = null
    // Directory with the extracted model weights (the directory inside the
    // <model>_weights.tar.gz of the model configuration). null = the pipeline
    // downloads the weights once on the submitting host (label 'download').
    model_dir    = null
    // Cap concurrent RUN_TIBERIUS forks (e.g. 1 on a single-GPU workstation).
    max_parallel = null
    // Forward to per-chunk tiberius.py; null = let tiberius auto-decide.
    batch_size   = null
    seq_len      = null
    // Genome chunking for parallel gene finder tasks; null = built-in defaults
    // (min_split_size 20000000, max_files 20).
    min_split_size = null
    max_files      = null
  }
  // Gene finder: 'tiberius' or 'vipsania'. null = the block with run = true.
  genefinder = null
  vipsania {
    run             = false
    // Clade name or model id, see the model table in the Vipsania README.
    model           = null
    // Directory with downloaded models (vipsania download -d DIR), for nodes without internet.
    model_dir       = null
    // Existing Vipsania prediction to use instead of running Vipsania.
    result          = null
    // Finetune on the target genome before annotating. The genome is then not split.
    finetune        = false
    finetune_epochs = null
    finetune_B      = null
    finetune_lr     = null
    // null = Vipsania sizes the batch from the GPU memory (needs nvidia-smi).
    batch_size      = null
    context         = null
    max_parallel    = null
    min_split_size  = null
    max_files       = null
    // Appended verbatim to `vipsania annotate`.
    extra_args      = null
  }
  // HC gene step per clade of the gene finder model: the Drusilla flow, or the
  // TransDecoder flow and its ORF finder (td1 or td2). Today Drusilla for
  // Vertebrata and Mammalia, TD2 for every other clade.
  hc_table = "${projectDir}/conf/hc_genes.yaml"
  // Drusilla flow: in evidence runs with transcripts (rnaseq, isoseq, mixed),
  // Drusilla ORFs of the filtered StringTie assembly replace the TransDecoder
  // high-confidence genes, and a LightGBM model filters the gene finder
  // predictions with protein evidence features.
  drusilla {
    // 'auto': for the clades with hc: drusilla in hc_table; true: always; false: never
    run               = 'auto'
    // Released Drusilla model (drusilla models list); null = drusilla_model of
    // the clade in hc_table
    model             = null
    // A local .weights.h5 file and its architecture YAML instead of a released model
    weights           = null
    config            = null
    // Model cache (DRUSILLA_CACHE_DIR); null = the pipeline downloads the model
    // once on the submitting host (label 'download')
    cache_dir         = null
    // null = Drusilla sizes the batch from the GPU memory
    batch_size        = null
    // Parallel Drusilla processes, each on a part of the transcripts; for CPU
    // nodes, where one process uses only 1-2 cores (e.g. 8 with 48 CPUs)
    shards            = 1
    min_coding_length = 200
    // Stop codon fix of the ORFs with protein alignments; start codon fix with
    // miniprothint start hints (needs fix_stop)
    fix_stop          = true
    fix_start         = true
    // StringTie pre-filter: length, coverage, TPM (relaxed TPM for long transcripts)
    min_length        = 300
    min_cov           = 3
    min_tpm           = 1
    long_length       = 3000
    min_tpm_long      = 0.5
    // LightGBM model that classifies gene finder transcripts as wrong, partial
    // or correct; required for the Drusilla flow. The released archive (URL or
    // local file), its unpacked directory, or a .txt text model with its .json.
    // Nextflow downloads a URL once per run. null = lgb_model and
    // lgb_model_sha256 of the clade in hc_table. lgb_model_sha256 is the
    // sha256 of the archive given here (null: not checked).
    lgb_model         = null
    lgb_model_sha256  = null
    // Keep transcripts with P(partial) + P(correct) >= lgb_threshold whose most likely class is in lgb_keep
    lgb_threshold     = 0.5
    lgb_keep          = 'correct'
    // Hint rescue: partial gene finder genes are predicted again by Tiberius
    // with the hints of their best protein chain; loci without a chain run ab
    // initio without hints. Needs a Tiberius with --hints
    // (branch hint_integration), which the image of the label hint_rescue has.
    // rescue_tiberius is another tiberius.py; null = the one of that image.
    // Without --hints the rescue is skipped with a warning, and no GPU task is
    // booked.
    rescue             = true
    rescue_tiberius    = null
    // null = the Tiberius model of the run, vertebrates for Vipsania runs
    rescue_model_cfg   = null
    rescue_flank       = 25000
    rescue_hint_weight = 2.5
    // ORF-agreement filter: skip loci where a Drusilla ORF already has all
    // introns of the chain. Off, as benchmarked.
    rescue_orf_filter  = false
    // Tiberius seq_len of the rescue (divisible by 18); loci are 25 kb flanks plus the gene
    rescue_seq_len     = 99990
  }
  // Pipeline mode: null = inferred from the inputs (abinitio, proteins, rnaseq, isoseq, mixed).
  mode = null
  scoring_matrix = "${projectDir}/conf/blosum62.csv"
  // RNA-Seq and Iso-Seq libraries whose alignment rate (samtools flagstat,
  // percent mapped) is below this value are dropped.
  min_alignment_rate = 80
  // ORF finder of the TransDecoder HC gene flow: 'td1' (TransDecoder 5.7.1)
  // or 'td2' (TD2 1.1.0, PSAURON-scored ORFs). null = orf_finder of hc_table
  // (td2).
  transdecoder = null
  // Appended verbatim to TD2.Predict, e.g. '--precise'.
  td2_predict_args = null
  // ---- post-processing of the final annotation (docs/postprocessing.md)
  postprocess {
    // Remove transcripts with an internal stop codon or a CDS length that is
    // not a multiple of 3; genes without a transcript left are removed.
    // false: report only (qc/sanity_filter.tsv).
    sanity_filter     = true
    // Add UTRs from the StringTie assemblies to transcripts without UTRs
    // (modes rnaseq, isoseq, mixed).
    utr               = true
    max_utr_extension = 5000   // bp beyond the CDS, as BRAKER4
  }
  // ---- quality control of the final annotation
  qc {
    // BUSCO/compleasm lineage, e.g. eukaryota_odb12, vertebrata_odb12
    // (without _odbNN: odb12). null = no completeness assessment.
    busco_lineage        = null
    // Directory with downloaded lineages (<dir>/lineages/<lineage>/, the
    // layout of busco --download). null = ~/.cache/paludamentum/busco; a
    // missing lineage is downloaded once on the submitting host.
    busco_download_path  = null
    compleasm            = true    // needs busco_lineage
    busco                = true    // needs busco_lineage
    omark                = false   // needs omamer_db
    omamer_db            = null    // OMAmer database (e.g. LUCA.h5)
    // Directory with the NCBI taxonomy for OMArk: ete3's taxa.sqlite, built
    // once on the submitting host from taxdump.tar.gz, which is downloaded
    // there unless the directory holds it. null = ~/.cache/paludamentum/ncbi_taxonomy
    ete_taxa_path        = null
    reference_annotation = null    // GFF3/GTF of a reference annotation for gffcompare
    gene_support         = true    // per-transcript hint support table
    statistics           = true    // gene set statistics and plots
    report               = true    // report.html
  }
  // ---- non-coding RNA annotation (<stem>_with_ncRNA.gff3)
  ncrna {
    run      = false
    // Directory with Rfam.cm and Rfam.clanin (Rfam 15.1). null =
    // ~/.cache/paludamentum/rfam, downloaded once on the submitting host.
    rfam_dir = null
    trnascan_high_confidence = false
    lncrna   = true      // FEELnc, modes with transcripts only
  }
  // ---- GO terms with FANTASIA-Lite (GPU; <stem>_go.gff3)
  fantasia {
    run          = false
    hf_cache_dir = null   // Hugging Face cache with Rostlab/prot_t5_xl_uniref50
    lookup_dir   = null   // lookup_table.npz, annotations.json, accessions.json (Zenodo 17720428)
    min_score    = 0.5
    additional_params = null   // appended verbatim to fantasia_pipeline.py
  }
  tools {
    hisat2   = "hisat2"
    hisat2_build = "hisat2-build"
    minimap2 = "minimap2"
    stringtie= "stringtie"
    samtools = "samtools"
    transdecoder_longorfs = "TransDecoder.LongOrfs"
    transdecoder_predict  = "TransDecoder.Predict"
    transdecoder_util_gtf2fa = "gtf_genome_to_cdna_fasta.pl"
    transdecoder_util_orf2genome = "cdna_alignment_orf_to_genome_orf.pl"
    transdecoder_gtf2gff = "gtf_to_alignment_gff3.pl"
    td2_longorfs = "TD2.LongOrfs"
    td2_predict  = "TD2.Predict"
    diamond  = "diamond"
    miniprot = "miniprot"
    miniprot_boundary_scorer = "miniprot_boundary_scorer"
    miniprothint = "miniprothint.py"
    bam2hints = "bam2hints"
    // post-processing tools; in the images of the labels postprocess, busco,
    // omark and container (gffread)
    gffread    = "gffread"
    compleasm  = "compleasm.py"
    busco      = "busco"
    gffcompare = "gffcompare"
    trnascan   = "tRNAscan-SE"
    cmscan     = "cmscan"
    cmpress    = "cmpress"
    barrnap    = "pybarrnap"
    omamer     = "omamer"
    omark      = "omark"
  }
}

// ========= PROCESS DEFAULTS =========

process {
  // Reasonable global defaults (can be overridden per label/profile).
  // Every tool runs with task.cpus threads, the CPUs reserved for the task.
  // params.threads is the default reservation; site configs may override cpus.
  cpus   = { params.threads ?: 48 }
  // Memory grows with the attempt: a task killed for memory (see the retry
  // rule below) gets twice as much the second time, three times the third.
  memory = { 30.GB * task.attempt }
  time   = '72h'
  stageInMode = 'symlink'
  // Fail on the first error in a pipeline such as `hisat2 | samtools sort`;
  // bash -ue alone lets a truncated BAM count as success.
  shell  = ['/bin/bash', '-euo', 'pipefail']
}

// ========= LABEL-BASED OVERRIDES =========

// Images. The gene finders are git submodules of this repository; the image
// tag pinned here must match the version of the submodule (the launcher warns
// otherwise). Every process carries exactly one image label.
process {
  // Evidence tools (StringTie, HISAT2, miniprot, TransDecoder, ...) and the
  // scripts in bin/, all pinned (docker/evidence/Dockerfile).
  withLabel: container {
    container = "docker://gaiusaugustus/paludamentum-evidence:0.2.2"
  }

  // Tiberius (RUN_TIBERIUS), built from the Dockerfile of the Tiberius submodule
  withLabel: tiberius {
    container = "docker://gaiusaugustus/tiberius:2.0.9"
  }

  withLabel: vipsania {
    container = "docker://gaiusaugustus/vipsania:1.0.2"
  }

  // Drusilla (ORF annotation, LightGBM filter): Drusilla at a pinned commit
  // with lightgbm (docker/drusilla/Dockerfile), tagged with the Drusilla
  // version. Its processes carry this label and never the label 'container'.
  withLabel: drusilla {
    container = "docker://gaiusaugustus/drusilla:0.1.0"
  }

  // Hint rescue: the Tiberius image with the Tiberius branch hint_integration,
  // the bricks2marble branch intron_hints and samtools
  // (docker/hint_rescue/Dockerfile).
  withLabel: hint_rescue {
    container = "docker://gaiusaugustus/paludamentum-hint-rescue:0.2.0"
  }

  // Post-processing tools (compleasm, gffcompare, tRNAscan-SE, Infernal,
  // pybarrnap, matplotlib for the report), all pinned (docker/postprocess/Dockerfile)
  withLabel: postprocess {
    container = "docker://gaiusaugustus/paludamentum-postprocess:0.1.1"
  }

  // BUSCO (completeness of genome and proteome; the lineage download)
  withLabel: busco {
    container = "docker://ezlabgva/busco:v6.1.0_cv2"
  }

  // FEELnc (lncRNA, modes with transcripts)
  withLabel: feelnc {
    container = "docker://quay.io/biocontainers/feelnc:0.2--pl526_0"
  }

  // OMArk and OMAmer (proteome consistency, qc.omark)
  withLabel: omark {
    container = "docker://quay.io/biocontainers/omark:0.4.1--pyh7e72e81_0"
  }

  // FANTASIA-Lite (GO terms, GPU). The patched embedding script of bin/ is
  // bound over the image's copy; containerOptions of a withName replaces the
  // gpu label's '--nv', so it is repeated here. The GPU computes the
  // embeddings; 8 CPUs for the lookup, not the 48 of the default.
  withLabel: fantasia {
    container = "docker://gaiusaugustus/fantasia-lite:1.0.1"
  }
  withName: 'FANTASIA_ANNOTATE' {
    cpus             = 8
    containerOptions = "--nv -B ${projectDir}/bin/fantasia_generate_embeddings.py:/opt/fantasia-lite/src/generate_embeddings.py"
  }
  // The GPU probe at the start of a run with fantasia.run (fails fast when
  // the label gpu gives no usable GPU). Minimal reservation, so it is
  // scheduled quickly; the '--nv' comes from the label gpu.
  withName: 'FANTASIA_GPU_CHECK' {
    cpus   = 1
    memory = '2 GB'
    time   = '1h'
  }

  // Single-threaded tasks of the post-processing (Python scripts, gffread,
  // gffcompare): one CPU. withName beats a site config's process.cpus, so a
  // site config overrides this with its own withName.
  withName: 'SANITY_FILTER|ADD_UTRS|FINALIZE_ANNOTATION|LONGEST_ISOFORM|GENE_SUPPORT|GENE_SET_STATISTICS|GFFCOMPARE|SOFTWARE_VERSIONS|REPORT|FILTER_BUSCO_PROTEINS|COMPLETENESS_SUMMARY|INFERNAL_TO_GFF3|FEELNC_TO_GFF3|MERGE_NCRNA|FANTASIA_SUMMARY|FANTASIA_DECORATE' {
    cpus = 1
  }

  // High-memory tasks
  withLabel: bigmem {
    memory = { 100.GB * task.attempt }
  }

  withLabel: local_only {
    executor = 'local'
    cpus     = 1
    memory   = '2 GB'
    time     = '1h'
  }

  // Downloads (SRA reads, OrthoDB partitions, Tiberius weights) run on the
  // submitting host, because compute nodes of many clusters have no internet.
  // Give this label a queue with internet access in your config if the head
  // node may not run them.
  // At most 4 CPUs, fewer when the submitting host has fewer: the local
  // executor stops the run for a task that asks for more CPUs than it has
  // (a 2-CPU Slurm head job).
  withLabel: download {
    executor = 'local'
    cpus     = { Math.min(4, Runtime.runtime.availableProcessors()) }
    memory   = '8 GB'
    time     = '48h'
  }
  // The Tiberius weights and the Drusilla model (curl and tar) need one CPU.
  // Not DOWNLOAD_NCBI_TAXONOMY: the ete3 build of taxa.sqlite needs about 3 GB
  // (the label's 8 GB).
  withName: 'DOWNLOAD_TIBERIUS_WEIGHTS|DOWNLOAD_RESCUE_WEIGHTS|DOWNLOAD_DRUSILLA_MODEL|DOWNLOAD_BUSCO_LINEAGE|DOWNLOAD_RFAM' {
    cpus   = 1
    memory = '2 GB'
    time   = '2h'
  }
  withName: 'DOWNLOAD_NCBI_TAXONOMY' {
    cpus = 1
  }

  // An SRA download that fails twice (a network error, or a run that
  // fasterq-dump cannot read, such as ERR237742) drops that accession with an
  // 'Error is ignored' note, as a library below min_alignment_rate is dropped;
  // the other libraries go on. -resume tries the dropped accession again.
  withName: 'DOWNLOAD_SRA_PAIRED|DOWNLOAD_SRA_SINGLE|DOWNLOAD_SRA_ISOSEQ' {
    errorStrategy = { task.attempt < 2 ? 'retry' : 'ignore' }
    maxRetries    = 1
  }

  // GPU tasks (cluster-specific GPU details are set in user configs)
  withLabel: gpu {
    containerOptions = '--nv'
  }

  // No bind over the container's /tmp: neither tool writes there (samtools
  // sort keeps its temporary files next to the output), and with
  // process.scratch the task directory itself lies under /tmp
  withName: 'HISAT2_MAP_SINGLE|HISAT2_MAP_PAIRED' {
    containerOptions = '--contain'
  }
}

// ========= EXECUTOR / RETRY BEHAVIOR =========

process {
  // Retry, with more memory, only tasks that the scheduler killed for memory
  // or time (SLURM exit codes 137, 140, 143, 247). Any other error is
  // deterministic: running tasks finish, no new ones start.
  errorStrategy = { task.exitStatus in [137, 140, 143, 247] ? 'retry' : 'finish' }
  maxRetries    = 2
  maxErrors     = -1
}

executor {
  queueSize = 20
}

singularity {
  enabled      = true
  autoMounts   = true
  envWhitelist = 'CUDA_VISIBLE_DEVICES'
  pullTimeout  = "60m"
  runOptions   = '--contain'
  // Images are pulled once into this directory and shared by all runs;
  // without it every new work directory pulls the images (about 9.4 GB per
  // gene finder image) again.
  // NXF_SINGULARITY_CACHEDIR overrides it.
  cacheDir     = System.getenv('NXF_SINGULARITY_CACHEDIR') ?: "${System.getenv('HOME')}/.cache/paludamentum/singularity"
}


// ========= REPORTING =========

timeline {
  enabled = true
}

trace {
  enabled = true
}

report {
  enabled = true
}
