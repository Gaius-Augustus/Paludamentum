// conf/cleanup.config
//
// Delete the task directories of this run from the work directory once the run
// has completed successfully. Every final output is published to outdir with
// mode 'copy', so nothing in outdir points into the work directory. The price:
// -resume of this run has nothing left to reuse. A failed run keeps its work
// directory. The launcher adds this config with --cleanup; for a bare
// `nextflow run main.nf` pass it with -c conf/cleanup.config.
cleanup = true
