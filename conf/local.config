// conf/local.config
//
// Run on one machine without a scheduler. The resources follow the machine:
// a task gets at most all its CPUs and, for memory, the smaller of the
// pipeline default and the physical memory.
includeConfig 'base.config'

process {
  executor = 'local'
  cpus     = { Math.min((params.threads ?: 48) as int, Runtime.runtime.availableProcessors()) }
  memory   = { [30.GB * task.attempt, localMemory()].min() }
  time     = '50h'

  withLabel: bigmem {
    memory = { [100.GB * task.attempt, localMemory()].min() }
  }
  withName: 'HISAT2_BUILD' {
    cpus = { Math.min(Math.min((params.threads ?: 32) as int, 32), Runtime.runtime.availableProcessors()) }
  }
  withName: 'FANTASIA_ANNOTATE' {
    cpus = { Math.min(8, Runtime.runtime.availableProcessors()) }
  }
}

// Physical memory of this machine, as Nextflow's local executor sees it.
def localMemory() {
  def bean = java.lang.management.ManagementFactory.operatingSystemMXBean
  return new nextflow.util.MemoryUnit(bean.totalMemorySize)
}
