// conf/slurm_generic.config
//
// A generic SLURM profile that may work on many clusters
// or at least serve as a starting point. Copy it and set the queues
// (partitions) of your cluster; see docs/hpc.md.
includeConfig 'base.config'
process {
  executor = 'slurm'
  cpus     = 4
  memory   = '16 GB'
  time     = '8h'

  // Gene finder tasks need a GPU. Set the GPU partition of your cluster and
  // the option that books a GPU there (--gpus=1, --gres=gpu:1, ...).
  withLabel: gpu {
    // queue          = 'gpu'
    clusterOptions = '--gpus=1'
    cpus           = 8
    memory         = '64 GB'
    time           = '72h'
    containerOptions = '--nv'
  }
}

singularity {
  enabled    = true
  autoMounts = true
}

executor {
  queueSize = 50
}
