// Config for `nextflow run main.nf -stub-run`: no containers, tiny resources.
includeConfig '../conf/base.config'

singularity.enabled = false
docker.enabled      = false

process {
  executor      = 'local'
  cpus          = 1
  memory        = '1 GB'
  time          = '10m'
  errorStrategy = 'terminate'
  maxRetries    = 0

  withLabel: container { container = null }
  withLabel: vipsania  { container = null }
  withLabel: bigmem    { memory = '1 GB' }
  withLabel: gpu       { containerOptions = null }
  withName: 'HISAT2_MAP_SINGLE|HISAT2_MAP_PAIRED' { containerOptions = null }
  // HISAT2_BUILD sets cpus in the process body; a selector is needed to override it
  withName: 'HISAT2_BUILD' { cpus = 1 }
}

timeline.enabled = false
trace.enabled    = false
report.enabled   = false
